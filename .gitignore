node_modules/
.env
.DS_Store
/.idea/

# Ignore generated audio files anywhere under a static/audio/generated folder
**/static/audio/generated/**

# Claude Code の個人設定(サンドボックス・権限の制限を含む)。git には含めない
.claude/settings.local.json
.claude/hooks/project-guard.js

# Playwright の出力
frontend/test-results/
frontend/playwright-report/

# 音声の一括作成(scripts/audio)の作業用フォルダ(作った mp3・状態・ログ)
/build/

# Python のキャッシュ
__pycache__/
*.pyc

# ログ・環境ごとの設定には、接続先や秘密情報が入りうる(git add -A で誤ってコミットしないよう除外する)
*.log
.env.*
!.env.example
